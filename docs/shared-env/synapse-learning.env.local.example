# Copy to synapse-learning/.env.local (or any sibling project)
# Same key works everywhere — quota is per Google Cloud project, not per repo.

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional aliases (Memora server resolves any of these):
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# After editing: restart dev server completely (Ctrl+C → npm run dev)
# Verify: node path/to/ai_tutor_studio/scripts/verify-gemini-key.mjs
