# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local   (macOS/Linux)
#   copy .env.local.example .env.local (Windows)
#
# .env.local is gitignored — never commit real API keys.

# Required for Agent, embeddings, and AI server routes.
# Get a key: https://aistudio.google.com/apikey
# Cross-project guide: docs/GEMINI_CROSS_PROJECT.md
# Verify: npm run verify:gemini   or   GET /api/health/gemini while dev server runs
GEMINI_API_KEY=

# Also accepted by server (same value, pick one):
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides (defaults: gemini-2.0-flash, gemini-embedding-001)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Local dev server (default in code: 3010)
PORT=3010

# Used for OAuth callbacks and self-referential links in local dev
APP_URL=http://localhost:3010

# Set to true in production to require Firebase ID tokens on /api routes (except health/logs).
# When enabled, also set VITE_REQUIRE_API_AUTH=true so the client attaches tokens.
# REQUIRE_API_AUTH=true
# VITE_REQUIRE_API_AUTH=true
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: forward xAPI statements to an LRS (Learning Record Store)
# XAPI_LRS_ENDPOINT=https://your-lrs.example.com/xapi
# XAPI_LRS_KEY=your-lrs-api-key

# Optional: override Yjs WebSocket URL (defaults to ws(s)://host/yjs)
# VITE_YJS_WS_URL=ws://localhost:3010/yjs

# Persistent audit log on disk (default: data/audit-log.jsonl)
# AUDIT_STORE_PATH=/app/data/audit-log.jsonl

# Firebase Admin SDK JSON for platform audit + multi-tenant admin metrics
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
