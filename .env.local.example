# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local   (macOS/Linux)
#   copy .env.local.example .env.local (Windows)
#
# .env.local is gitignored — never commit real API keys.

# Required for Agent, embeddings, and AI server routes.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local dev server (default in code: 3010)
PORT=3010

# Used for OAuth callbacks and self-referential links in local dev
APP_URL=http://localhost:3010
