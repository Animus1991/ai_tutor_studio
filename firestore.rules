rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidTask(data, uid) {
      return data.keys().hasAll(['title', 'course', 'completed', 'userId', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.course is string && data.course.size() <= 100 &&
             data.completed is bool &&
             data.userId == uid &&
             (!data.keys().hasAny(['type']) || (data.type is string && data.type.size() <= 50)) &&
             (!data.keys().hasAny(['time']) || (data.time is string && data.time.size() <= 50)) &&
             (!data.keys().hasAny(['urgent']) || data.urgent is bool) &&
             (!data.keys().hasAny(['icon']) || (data.icon is string && data.icon.size() <= 50)) &&
             (!data.keys().hasAny(['color']) || (data.color is string && data.color.size() <= 50)) &&
             (!data.keys().hasAny(['bg']) || (data.bg is string && data.bg.size() <= 50)) &&
             (!data.keys().hasAny(['repetition']) || data.repetition is number) &&
             (!data.keys().hasAny(['interval']) || data.interval is number) &&
             (!data.keys().hasAny(['easeFactor']) || data.easeFactor is number) &&
             (!data.keys().hasAny(['nextReviewDate']) || data.nextReviewDate is string);
    }

    function isValidCourse(data, uid) {
      return data.keys().hasAll(['title', 'userId', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.userId == uid &&
             (!data.keys().hasAny(['progress']) || data.progress is number) &&
             (!data.keys().hasAny(['documents']) || data.documents is number) &&
             (!data.keys().hasAny(['lastActive']) || (data.lastActive is string && data.lastActive.size() <= 50)) &&
             (!data.keys().hasAny(['color']) || (data.color is string && data.color.size() <= 50)) &&
             (!data.keys().hasAny(['bg']) || (data.bg is string && data.bg.size() <= 50));
    }

    function isValidMessage(data, uid, rId) {
      return data.keys().hasAll(['roomId', 'user', 'text', 'userId', 'createdAt']) &&
             data.roomId == rId &&
             data.user is string && data.user.size() <= 100 &&
             data.text is string && data.text.size() <= 1000 &&
             data.userId == uid &&
             (!data.keys().hasAny(['time']) || (data.time is string && data.time.size() <= 50));
    }
    
    function isValidParticipant(data, uid, rId) {
      return data.keys().hasAll(['roomId', 'email', 'status', 'userId', 'createdAt']) &&
             data.roomId == rId &&
             data.email is string && data.email.size() <= 100 &&
             data.status is string && data.status.matches('^(pending|accepted)$') &&
             data.userId == uid;
    }

    function isValidQuiz(data, uid, rId) {
      return data.keys().hasAll(['roomId', 'formId', 'formUrl', 'title', 'userId', 'createdAt']) &&
             data.roomId == rId &&
             data.formId is string && data.formId.size() <= 200 &&
             data.formUrl is string && data.formUrl.size() <= 500 &&
             data.title is string && data.title.size() <= 200 &&
             data.userId == uid;
    }

    function isValidFeedback(data, uid) {
      return data.keys().hasAll(['type', 'description', 'userId', 'userEmail', 'status', 'createdAt']) &&
             data.type is string && data.type.matches('^(bug|feature)$') &&
             data.description is string && data.description.size() <= 2000 &&
             data.userId == uid &&
             data.userEmail is string && data.userEmail.size() <= 100 &&
             data.status is string && data.status == 'new';
    }

    function isValidActivity(data) {
      return data.keys().hasOnly(['title', 'type', 'timestamp']) &&
             data.keys().hasAll(['title', 'type', 'timestamp']) &&
             data.title is string && data.title.size() <= 300 &&
             data.type is string && data.type.matches('^(study|upload|collab|task|other)$') &&
             data.timestamp == request.time;
    }

    function isValidDocument(data) {
      return data.keys().hasOnly(['title', 'content', 'createdAt', 'sourceUrl']) &&
             data.keys().hasAll(['title', 'content', 'createdAt', 'sourceUrl']) &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 500000 &&
             data.sourceUrl is string && data.sourceUrl.size() <= 2048;
    }

    function isValidDeck(data) {
      return data.keys().hasOnly(['title', 'createdAt']) &&
             data.keys().hasAll(['title', 'createdAt']) &&
             data.title is string && data.title.size() <= 300;
    }

    function isValidFlashcard(data) {
      return data.keys().hasOnly([
               'deckId', 'front', 'back', 'createdAt', 'repetition',
               'interval', 'easeFactor', 'nextReviewDate', 'imageUrl', 'box', 'type'
             ]) &&
             data.keys().hasAll(['deckId', 'front', 'back', 'createdAt']) &&
             data.deckId is string && data.deckId.size() <= 128 &&
             data.front is string && data.front.size() <= 5000 &&
             data.back is string && data.back.size() <= 10000 &&
             (!data.keys().hasAny(['repetition']) || data.repetition is number) &&
             (!data.keys().hasAny(['interval']) || data.interval is number) &&
             (!data.keys().hasAny(['easeFactor']) || data.easeFactor is number) &&
             (!data.keys().hasAny(['nextReviewDate']) || data.nextReviewDate is string) &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 750000)) &&
             (!data.keys().hasAny(['box']) || (data.box is list && data.box.size() == 4)) &&
             (!data.keys().hasAny(['type']) || data.type == 'occlusion');
    }

    function isRoomOwner(roomId) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }

    function hasRoomAccess(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && isVerified() &&
             (room.ownerId == request.auth.uid ||
              (request.auth.token.email is string &&
               room.memberEmails is list &&
               request.auth.token.email in room.memberEmails));
    }

    function isValidRoom(data, uid) {
      return data.keys().hasAll(['ownerId', 'memberEmails', 'createdAt']) &&
             data.keys().hasOnly(['ownerId', 'memberEmails', 'createdAt', 'offer', 'answer']) &&
             data.ownerId == uid &&
             data.memberEmails is list && data.memberEmails.size() <= 100;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, list: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(taskId) &&
                       request.auth.uid == userId &&
                       isValidTask(incoming(), userId) &&
                       incoming().createdAt == request.time;
      allow update: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(taskId) &&
                       request.auth.uid == userId &&
                       isValidTask(incoming(), userId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(taskId) && request.auth.uid == userId;
    }

    match /users/{userId}/courses/{courseId} {
      allow read, list: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(courseId) &&
                       request.auth.uid == userId &&
                       isValidCourse(incoming(), userId) &&
                       incoming().createdAt == request.time;
      allow update: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(courseId) &&
                       request.auth.uid == userId &&
                       isValidCourse(incoming(), userId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(courseId) && request.auth.uid == userId;
    }

    match /users/{userId}/activityLogs/{activityId} {
      allow read, list: if isSignedIn() && isVerified() &&
                         isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(activityId) &&
                     request.auth.uid == userId && isValidActivity(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(activityId) &&
                     request.auth.uid == userId;
    }

    match /users/{userId}/documents/{documentId} {
      allow read, list, delete: if isSignedIn() && isVerified() &&
                                isValidId(userId) && isValidId(documentId) &&
                                request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(documentId) &&
                     request.auth.uid == userId &&
                     isValidDocument(incoming()) &&
                     incoming().createdAt == request.time;
      allow update: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(documentId) &&
                     request.auth.uid == userId &&
                     isValidDocument(incoming()) &&
                     incoming().createdAt == existing().createdAt;
    }

    match /users/{userId}/decks/{deckId} {
      allow read, list, delete: if isSignedIn() && isVerified() &&
                                isValidId(userId) && isValidId(deckId) &&
                                request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(deckId) &&
                     request.auth.uid == userId && isValidDeck(incoming()) &&
                     incoming().createdAt == request.time;
      allow update: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(deckId) &&
                     request.auth.uid == userId && isValidDeck(incoming()) &&
                     incoming().createdAt == existing().createdAt;
    }

    match /users/{userId}/flashcards/{flashcardId} {
      allow read, list, delete: if isSignedIn() && isVerified() &&
                                isValidId(userId) && isValidId(flashcardId) &&
                                request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(flashcardId) &&
                     request.auth.uid == userId && isValidFlashcard(incoming()) &&
                     incoming().createdAt == request.time;
      allow update: if isSignedIn() && isVerified() &&
                     isValidId(userId) && isValidId(flashcardId) &&
                     request.auth.uid == userId && isValidFlashcard(incoming()) &&
                     incoming().createdAt == existing().createdAt;
    }

    // Room metadata is the authorization source for chat, CRDT and signaling.
    match /rooms/{roomId} {
      allow read: if isValidId(roomId) && hasRoomAccess(roomId);
      allow create: if isSignedIn() && isVerified() && isValidId(roomId) &&
                     isValidRoom(incoming(), request.auth.uid) &&
                     incoming().createdAt == request.time;
      allow update: if isValidId(roomId) && hasRoomAccess(roomId) &&
                     incoming().ownerId == existing().ownerId &&
                     incoming().createdAt == existing().createdAt &&
                     (
                       (isRoomOwner(roomId) &&
                        isValidRoom(incoming(), existing().ownerId)) ||
                       incoming().memberEmails == existing().memberEmails
                     );
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read, create: if isValidId(roomId) && isValidId(candidateId) &&
                            hasRoomAccess(roomId) &&
                            candidateCollection.matches('^(callerCandidates|calleeCandidates)$');
        allow update, delete: if false;
      }
    }

    // y-fire owns the nested CRDT schema; room metadata controls access.
    match /yjs_state/{roomId} {
      allow read, write: if isValidId(roomId) && hasRoomAccess(roomId);
    }
    match /yjs_state/{roomId}/{document=**} {
      allow read, write: if isValidId(roomId) && hasRoomAccess(roomId);
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow read, list: if isValidId(roomId) && hasRoomAccess(roomId);
      allow create: if isValidId(roomId) && hasRoomAccess(roomId) && isValidId(messageId) &&
                       isValidMessage(incoming(), request.auth.uid, roomId) &&
                       incoming().createdAt == request.time;
      allow update: if isValidId(roomId) && hasRoomAccess(roomId) && isValidId(messageId) &&
                       isValidMessage(incoming(), request.auth.uid, roomId) &&
                       incoming().userId == existing().userId && 
                       request.auth.uid == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(roomId) && hasRoomAccess(roomId) &&
                       isValidId(messageId) && request.auth.uid == existing().userId;
    }

    match /rooms/{roomId}/participants/{participantId} {
      allow read, list: if isValidId(roomId) && hasRoomAccess(roomId);
      allow create: if isValidId(roomId) && isRoomOwner(roomId) && isValidId(participantId) &&
                       isValidParticipant(incoming(), request.auth.uid, roomId) &&
                       incoming().createdAt == request.time;
      allow update: if isValidId(roomId) && isRoomOwner(roomId) && isValidId(participantId) &&
                       isValidParticipant(incoming(), request.auth.uid, roomId) &&
                       incoming().userId == existing().userId &&
                       request.auth.uid == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(roomId) && isRoomOwner(roomId) &&
                       isValidId(participantId);
    }
    match /rooms/{roomId}/quizzes/{quizId} {
      allow read, list: if isValidId(roomId) && hasRoomAccess(roomId);
      allow create: if isValidId(roomId) && hasRoomAccess(roomId) && isValidId(quizId) &&
                       isValidQuiz(incoming(), request.auth.uid, roomId) &&
                       incoming().createdAt == request.time;
      allow update: if isValidId(roomId) && hasRoomAccess(roomId) && isValidId(quizId) &&
                       isValidQuiz(incoming(), request.auth.uid, roomId) &&
                       incoming().userId == existing().userId &&
                       request.auth.uid == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(roomId) && hasRoomAccess(roomId) &&
                       isValidId(quizId) && request.auth.uid == existing().userId;
    }

    match /feedback/{feedbackId} {
      allow create: if isValidId(feedbackId) &&
                       isValidFeedback(incoming(), isSignedIn() ? request.auth.uid : 'anonymous') &&
                       incoming().createdAt == request.time;
      allow read, update, delete: if false; 
    }

    // Platform audit — written only via Firebase Admin SDK on the server
    match /platform_audit/{eventId} {
      allow read, write: if false;
    }
  }
}
